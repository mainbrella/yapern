{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dc-web",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "dc-foo.com",
      "custom_domain": true
    }
  ]
}
