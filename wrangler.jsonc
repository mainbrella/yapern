{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yapern-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/messages"],
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "yapern.com",
      "custom_domain": true
    }
  ]
}
